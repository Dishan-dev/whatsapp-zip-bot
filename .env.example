# Allowed sender number(s), including country code. Separate several with commas:
# TARGET_NUMBER=94763570108,94760868809
TARGET_NUMBER=
TARGET_IDS=

# Optional: the BOT's own number (the WhatsApp account the bot runs on).
# When set, the log shows an 8-character pairing code to type on the bot's phone
# instead of a QR code to scan.
# PAIRING_NUMBER=

# Optional: use installed Chrome and skip Puppeteer's browser download.
# Set this BEFORE running npm install. Leave unset to download bundled Chrome.
# CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"

HEADLESS=true
MAX_ZIP_MB=100
